# This .env file is passed to Docker Compose.
# The environment variables does not reach the containers.
# To define environment variables that the DeepSeek Harness container payload
# can use, use `srv_agent/.env` file.

# Ports that the Docker Compose cluster expose to the host (or WSL host) environment.
# They are intentionally non-public, allowing only access from 127.0.0.1 and [::1].
# It is encouraged to use another reverse proxy on host and allow only very
# specific remote addresses that only access the services through secure
# tunnels (not plain HTTP over a conventional unencrypted stack).
# Be aware that the srv_inbounds nginx service never sees true client IP address
# if directly accessed.
# DSH_EXPOSE_PORT=3080
# PINCHTAB_EXPOSE_PORT=3082

# Trust the host-port combinations that you may. Useful reference:
# - `--trusted-host <host>:<port>` trusts the host-port combinations to which
#   you may expose the DSH service via proxy, allowing the exposed service to
#   actually function.
# DSH_EXTRA_ARGS=
