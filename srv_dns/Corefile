# =============================================================================
# CoreDNS Configuration for DeepSeek Harness Sandbox
# =============================================================================
# A minimal forwarding-only resolver. It sits on ai_net (where srv_agent can
# reach it) and on external_net (so it can reach the host's resolvers through
# Docker's embedded DNS). This is what lets PinchTab's navigation DNS preflight
# resolve hostnames even though srv_agent itself has no external network access.

.:53 {
    errors
    log
    cache 30

    hosts {
        # FIXME: The fake IPs are truly fake now (only intended to bypass SSRF checks).
        #        Outbounds proxy does not rewrite them to the actual address.
        #        This causes no problems with PinchTab, but might cause problems will some other tools.
        198.18.0.1          host.docker.internal  # Fake IP for host
        fdfe:dcba:9876::1   host.docker.internal  # IPv6 fake IP for host
        
        fallthrough
    }

    forward . 1.1.1.1 8.8.8.8 /etc/resolv.conf {
        # 'sequential' ensures it tries the first upstream, and only moves to 
        # the next one if the first one times out or fails to connect.
        policy sequential
    }
}
